@article{Riaz2024,
   abstract = {The increasing reliance on web interfaces for online activities such as shopping, working, and socializing has highlighted the importance of ethical UI/UX design. However, the rise of manipulative web design techniques presents a problem. These techniques subtly influence user behavior in ways that can lead to privacy invasions, unwanted purchases, and other negative outcomes. They may also exploit users' psychological biases, making it difficult to recognize the manipulation.This paper collects, details, and organizes the manipulation techniques in UI/UX web design. Each technique is detailed and organized into 10 different categories. Also, this work details which techniques require user action or user awareness, leading users to take unintended actions or coerce them into unwanted decisions through manipulation. Use cases and possible countermeasures are also discussed. This contribution serves as the basis for a future assessment of the impact of these techniques and the development of ethical web design practices.},
   author = {Rimsha Riaz and Aurora Vasconcelos and Pedro Pinto},
   doi = {10.1109/CARS61786.2024.10778887},
   isbn = {9798350386417},
   journal = {2024 Cyber Awareness and Research Symposium, CARS 2024},
   keywords = {Dark patterns,Psychological Manipulation,Social Engineering,UI/UX design,User Manipulation,Web Design},
   publisher = {Institute of Electrical and Electronics Engineers Inc.},
   title = {An Overview of User Psychological Manipulation Techniques in UI/UX Web Design},
   year = {2024}
}
@article{Dong2024,
   abstract = {Figure 1: The exploratory study setup and screenshots of the experiences: a) experimental setup, b) introduction to Event 1 (E1), c) 'Inform' in E1, d) 'Nudge' in E1, e) 'Recommend' in E1, and f) 'Instruct' in E1. Abstract The integration of extended reality (XR) with artificial intelligence (AI) introduces a new paradigm for user interaction, enabling AI to perceive user intent, stimulate the senses, and influence decision-making. We explored the impact of four AI-driven visualisation techniques-'Inform, ' 'Nudge, ' 'Recommend, ' and 'Instruct'-on user decision-making in XR using the Meta Quest Pro. To test these techniques, we used a pre-recorded 360 • video of a supermarket, overlaying each technique through a virtual interface. We aimed to investigate how these different visualisation techniques with different levels of user autonomy impact preferences and decision-making. An exploratory study with semi-structured interviews provided feedback and design recommendations. Our findings emphasise the importance of maintaining user autonomy, enhancing AI transparency to build trust, and considering context in visualisa-tion design. This work is licensed under a Creative Commons Attribution 4.0 International License. OzCHI '24,},
   author = {Ze Dong and Binyang Han and Jingjing Zhang and Ruoyu Wen and Barrett Ens and Adrian James Clark and Thammathip Piumsomboon},
